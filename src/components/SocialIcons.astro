---
/**
 * Official brand icons (Simple Icons, CC0) for her contact channels.
 * Each icon always shows in colour (a plain envelope for email, LinkedIn's
 * own blue); hovering lifts it and adds a soft glow. No fills, no labels.
 * Only channels with a link are shown.
 */
import { siLinkedin, siInstagram, siX, siTelegram, siWhatsapp, siFacebook, siTiktok } from 'simple-icons';

interface Props { email: string; linkedin: string; socials?: Record<string, string>; size?: 'lg' | 'sm' }
const { email, linkedin, socials = {}, size = 'lg' } = Astro.props;

const all = [
  { icon: null, href: `mailto:${email}`, label: 'Email' },
  { icon: siLinkedin, href: linkedin, label: 'LinkedIn' },
  { icon: siInstagram, href: socials.instagram, label: 'Instagram' },
  { icon: siX, href: socials.x, label: 'X' },
  { icon: siTelegram, href: socials.telegram, label: 'Telegram' },
  { icon: siWhatsapp, href: socials.whatsapp, label: 'WhatsApp' },
  { icon: siFacebook, href: socials.facebook, label: 'Facebook' },
  { icon: siTiktok, href: socials.tiktok, label: 'TikTok' },
].filter((s) => s.href);
// Brands whose colour is black use the page ink so they stay visible in both themes.
const brand = (hex?: string) => (!hex ? 'var(--red)' : hex === '000000' ? 'var(--ink)' : `#${hex}`);
---
<ul class={`soc soc--${size}`} role="list">
  {all.map((s) => (
    <li>
      <a
        class="soc__a"
        href={s.href}
        target={s.href!.startsWith('mailto:') ? undefined : '_blank'}
        rel={s.href!.startsWith('mailto:') ? undefined : 'noopener'}
        aria-label={s.label}
        data-magnetic="0.35"
        style={`--brand:${brand(s.icon?.hex)}`}
      >
        {s.icon ? (
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.icon.path} /></svg>
        ) : (
          <svg class="soc__mail" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="2.6" /><path d="m4.2 7.6 7.8 5.9 7.8-5.9" /></svg>
        )}
      </a>
    </li>
  ))}
</ul>

<style>
  .soc { display: flex; gap: 12px; flex-wrap: wrap; padding: 0; margin: 0; }
  .soc__a {
    --s: 64px;
    width: var(--s); height: var(--s); border-radius: 50%; display: grid; place-items: center; position: relative;
    border: 1px solid var(--rule); background: var(--tile, var(--paper-3)); color: var(--brand);
    transition: transform .5s var(--ease-out), box-shadow .5s var(--ease-out), border-color .35s;
  }
  .soc--sm .soc__a { --s: 44px; }
  .soc__a:hover, .soc__a:focus-visible {
    transform: translateY(-3px); border-color: color-mix(in oklab, var(--brand) 60%, transparent);
    box-shadow: 0 14px 28px -10px color-mix(in oklab, var(--brand) 55%, transparent), 0 0 0 4px color-mix(in oklab, var(--brand) 14%, transparent);
  }
  .soc__a svg { width: 42%; height: 42%; fill: currentColor; transition: transform .5s var(--ease-out); }
  .soc__a svg.soc__mail { width: 46%; height: 46%; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .soc__a:hover svg { transform: scale(1.12); }
</style>
